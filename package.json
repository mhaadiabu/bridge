{
  "name": "upsa-bridge-rebuild",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "node -e \"const [major, minor] = process.versions.node.split('.').map(Number); if (major < 20 || (major === 20 && minor < 9) || major >= 24) { console.error('Unsupported Node.js ' + process.version + ' for this Expo SDK 54 project on Windows. Use Node 20.9+ or 22.x (avoid Node 24 for now).'); process.exit(1); }\"",
    "start": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --tunnel",
    "start:lan": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --lan",
    "start:localhost": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --localhost",
    "convex:dev": "convex dev",
    "convex:setup": "convex dev --configure --until-success",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.9.0 <24"
  },
  "dependencies": {
    "@clerk/expo": "~3.2.0",
    "@t3-oss/env-core": "^0.13.8",
    "convex": "1.36.1",
    "expo": "~54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/react": "~19.1.0",
    "cross-env": "^7.0.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
